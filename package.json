{
  "name": "xhs-ai-content-studio",
  "version": "0.1.0",
  "description": "Local AI Agent workspace for Xiaohongshu research, rewriting, image generation, and publishing assembly.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "acceptance": "vitest run tests",
    "verify": "npm run acceptance && npm run typecheck && npm run build",
    "smoke:safe": "npm run smoke:local && npm run smoke:accounts && npm run smoke:studio-state && npm run smoke:chat-stream && npm run smoke:publish-dry-run && npm run smoke:acceptance-status",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:accounts": "node scripts/account-smoke.mjs",
    "smoke:studio-state": "node scripts/studio-state-smoke.mjs",
    "smoke:chat-stream": "node scripts/chat-stream-smoke.mjs",
    "smoke:research": "node scripts/research-smoke.mjs",
    "smoke:publish-dry-run": "node scripts/publish-dry-run-smoke.mjs",
    "smoke:acceptance-status": "node scripts/acceptance-status-smoke.mjs",
    "acceptance:evidence-package": "node scripts/export-acceptance-evidence-package.mjs",
    "acceptance:validate-evidence": "node scripts/validate-acceptance-evidence-package.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
